# ============================================================
# .env.local — único arquivo na raiz do monorepo, lido por web e api
# Setup: `cp .env.example .env.local` e depois `npm run env:link`
# (`env:link` cria symlinks em apps/web/.env.local e apps/api/.env
# apontando para este arquivo na raiz)
# ============================================================

# --- Auth (web e api compartilham NEXTAUTH_SECRET) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                  # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web ---
API_URL=http://localhost:3001

# --- API ---
ALLOWED_ORIGINS=http://localhost:3000
PORT=3001
NODE_ENV=development
# CSV de emails que recebem role ADMIN no primeiro login.
ADMIN_EMAILS=

# --- S2S (web → api) ---
# openssl rand -base64 48
# Railway: setar no api, web usa service reference ${{api.INTERNAL_SERVICE_TOKEN}}
INTERNAL_SERVICE_TOKEN=

# --- DB (api only) ---
DATABASE_URL=postgresql://kainos:kainos@localhost:5432/kainos

# ============================================================
# Storage (api only) — módulo opcional, ver docs/modules.md
# ------------------------------------------------------------
# volume = FS local (dev/test, Railway Volume)
# r2     = Cloudflare R2 (prod)
# ============================================================
STORAGE_DRIVER=volume
VOLUME_ROOT=./.data/volume
STORAGE_URL_SECRET=               # openssl rand -base64 32
UPLOAD_MAX_BYTES=10485760

# R2 — obrigatório apenas quando STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ============================================================
# LLM (opcional — ai-runtime usa quando habilitado)
# ------------------------------------------------------------
# Em DEV local: LLM_PROVIDER=mock (sem consumo de tokens).
# Em PROD: LLM_PROVIDER=openai + OPENAI_API_KEY setada.
# ============================================================
OPENAI_API_KEY=
LLM_PROVIDER=mock                 # openai | mock
MARKET_TIMEOUT_MS=4000
AI_RUNTIME_FIXTURE=false

# ============================================================
# Fila distribuída — BullMQ + Redis (api only)
# ------------------------------------------------------------
# Railway: adicionar Redis como serviço managed; a URL é
# injetada automaticamente como REDIS_URL.
# Dev local: roda no docker-compose (`npm run db:up` sobe Postgres+Redis).
# ============================================================
REDIS_URL=redis://localhost:6379

# Bull Board — dashboard de jobs (admin only)
# BULL_BOARD_ENABLED=true          # habilitar em produção
# BULL_BOARD_BASIC_AUTH_USER=      # usuário basic auth
# BULL_BOARD_BASIC_AUTH_PASSWORD=  # senha basic auth
# BULL_DASHBOARD_URL=              # URL pública do Bull Board (mostrada no /admin)
